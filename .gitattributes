# Normalise line endings across Windows (WSL) and Linux checkouts.
* text=auto eol=lf

# Shell scripts must stay LF or they will not run after a Windows checkout.
*.sh   text eol=lf

# Molecular and simulation formats are plain text.
*.pdb  text eol=lf
*.gro  text eol=lf
*.itp  text eol=lf
*.top  text eol=lf
*.mdp  text eol=lf
*.mol2 text eol=lf
*.sdf  text eol=lf

# Binary — never normalise.
*.png  binary
*.jpg  binary
*.pdf  binary
*.xtc  binary
*.trr  binary
*.tpr  binary
*.edr  binary
*.cpt  binary
